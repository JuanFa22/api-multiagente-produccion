# Copiá este archivo a .env y completá tus claves (NO subas .env a GitHub)

# --- LLM (Gemini) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Observabilidad: elegí UNA ---
# Opción A (recomendada, local y sin cuenta): Arize Phoenix. Phoenix debe estar corriendo en http://localhost:6006
OBSERVABILITY=phoenix
PHOENIX_URL=http://localhost:6006
PHOENIX_PROJECT=api-multiagente-produccion
# Opción B: LangSmith. Poné OBSERVABILITY= (vacío) y completá lo de abajo
# --- LangSmith (https://smith.langchain.com -> Settings -> API Keys) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=api-multiagente-produccion
